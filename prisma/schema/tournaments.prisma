enum TournamentFormatKind {
  /// Knockout (decision 37).
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  /// One group, everyone plays everyone.
  ROUND_ROBIN
  SWISS
  /// Round-robin groups feeding a knockout (decision 37, P80).
  GROUPS_KNOCKOUT
  /// Padel's social formats: rotating partners, a points table, no ratings (43).
  AMERICANO
  MEXICANO
  /// A fixed round robin over weeks, in divisions, each round by a deadline (44).
  LEAGUE
}

/// How a tournament's entry fee is paid (decision 39, P80).
enum TournamentFeePayment {
  AT_CLUB
  /// Through Stripe Connect (#581); refused until the club has connected.
  ONLINE
}

/// An entry's way through the club's confirmation (decisions 38, 51; P80).
enum TournamentEntryStatus {
  /// Waiting for the club; past the draw size, the waiting list, in sign-up order.
  PENDING
  CONFIRMED
  DECLINED
  WITHDRAWN
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

model Tournament {
  id       String @id @default(cuid())
  tenantId String

  name   String
  sport  SportType
  format TournamentFormatKind
  status TournamentStatus     @default(DRAFT)

  startsAt      DateTime
  /// The draw size: entries the club confirms, whether one player or a pair each.
  maxPlayers    Int
  entryFeeCents Int      @default(0)

  /// Where it is played (P80): its courts take its matches, its city lists it.
  venueId         String?
  description     String?
  endsAt          DateTime?
  /// Sign-up closes then; null = when the club starts the draw.
  entriesCloseAt  DateTime?
  /// 1 singles, 2 doubles: an entry is a player, or a player and a partner (50).
  teamSize        Int                  @default(1)
  feePayment      TournamentFeePayment @default(AT_CLUB)
  createdByUserId String?

  /// Groups feeding a knockout (55): how many groups, and how many from each go through.
  groupCount         Int?
  qualifiersPerGroup Int?
  /// A match for third place between the semi-final losers (61).
  thirdPlace         Boolean   @default(false)
  /// When the club made the draw (#580): from then on it is IN_PROGRESS.
  drawnAt            DateTime?
  /// Americano and Mexicano (#590; decisions 56, 60): the rounds the club
  /// sets, and the points a match is played to.
  rounds             Int?
  pointsPerMatch     Int?
  /// A league (#591, decision 44): the days between one round's deadline and the next.
  roundDays          Int?

  currentRound Int @default(0)
  totalRounds  Int @default(0)

  /// The pairing library's OWN serialised state, for SWISS only.
  ///
  /// `tournament-organizer` RANDOMISES its opening bracket, so the pairings
  /// cannot be recomputed from the results — recomputing invents a DIFFERENT
  /// tournament from the one that was played, and then applies real results to
  /// fixtures that never existed. The state IS the record. See
  /// src/lib/tournaments/swiss.ts.
  stateJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TournamentEntry[]
  matches TournamentMatch[]
  venue   Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@index([venueId])
  @@index([tenantId, status, startsAt])
  @@index([tenantId])
  @@map("tournament")
}

model TournamentEntry {
  id           String @id @default(cuid())
  tenantId     String
  tournamentId String

  /// Who signed up: the entrant, or the first of a pair.
  playerUserId      String
  /// Their partner in a doubles tournament, named by the entrant (decision 50).
  partnerUserId     String?
  status            TournamentEntryStatus @default(PENDING)
  decidedAt         DateTime?
  decidedByUserId   String?
  /// Who withdrew it: the entrant, the partner, or the club.
  withdrawnByUserId String?
  /// In the group stage, the group (55); its seed in the draw (54).
  groupNo           Int?
  seed              Int?
  /// Seed weight at the moment of entry. Frozen: a player's live rating moving
  /// mid-event must not re-seed a bracket that is already being played.
  seedRating        Int?

  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// One entry per player. Without it, a double-tapped "Enter" puts somebody in
  /// the draw twice — and the bracket pairs them against themselves.
  @@unique([tournamentId, playerUserId])
  /// A partner is in one pair of a tournament at most.
  @@unique([tournamentId, partnerUserId])
  @@index([tenantId])
  @@index([playerUserId])
  @@index([partnerUserId])
  @@index([tournamentId, status, createdAt])
  @@map("tournament_entry")
}

/// Where a match sits in a club tournament's draw (#580, P81).
enum TournamentStage {
  GROUP
  KNOCKOUT
  /// The semi-final losers, when the club chose one (decision 61).
  THIRD_PLACE
}

/// A draw's match through the tournament (#580, P81).
enum TournamentMatchStatus {
  /// A side is not known yet: an earlier match decides it.
  PENDING
  /// Both sides known; not played yet.
  READY
  /// Played, and its result counted: rated (29), the draw moved on.
  PLAYED
  /// Won without playing: a bye, a withdrawal (59), or the club's decision (58).
  WALKOVER
}

/// One match of a club tournament's draw (#580, P81). Every match of a
/// knockout exists from the draw, pointing at the one its winner goes on to;
/// a group's are everyone against everyone. Its sides are entries, a player
/// or a pair. Put on a court, it is a booking (decision 40), and the booking's
/// result is the match's.
model TournamentMatch {
  id           String @id @default(cuid())
  tenantId     String
  tournamentId String

  stage   TournamentStage
  round   Int
  slot    Int
  /// 1.. in the group stage; 0 in a knockout.
  groupNo Int             @default(0)

  /// Null until an earlier match decides it; side B null in round 1 is a bye.
  entryAId  String?
  entryBId  String?
  /// Americano and Mexicano (#590): each side is two players who signed up
  /// alone, partnered for this round only. The second of each side.
  entryA2Id String?
  entryB2Id String?

  status     TournamentMatchStatus @default(PENDING)
  /// 0 = side A won, 1 = side B, null = not decided or a group draw.
  winnerSide Int?
  /// Side A first in each pair, as the result counted it.
  scoreJson  Json?

  /// The booking that put it on a court and time (40). Its result is the match's.
  bookingId String? @unique

  /// Where the winner goes, and on which side; where a semi-final's loser goes (61).
  nextMatchId      String?
  nextSide         Int?
  loserNextMatchId String?
  loserNextSide    Int?

  /// A league's round (#591, 44): played by then, or the club decides it (58).
  deadline        DateTime?
  /// The club staff member who recorded a walkover (58, 59).
  decidedByUserId String?
  playedAt        DateTime?
  createdAt       DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  booking    Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// A match exists once in its place in the draw.
  @@unique([tournamentId, stage, groupNo, round, slot])
  @@index([tenantId])
  @@index([entryAId])
  @@index([entryBId])
  @@index([entryA2Id])
  @@index([entryB2Id])
  @@index([status, deadline])
  @@map("tournament_match")
}
