/// The core of the product.
///
/// Double-booking is prevented by a Postgres EXCLUDE constraint (see the
/// `booking_exclusion` migration), NOT by an application-layer "is this
/// slot free?" check. Under concurrency a read-then-write check always
/// loses: two requests both read "free", both write, both succeed. The
/// constraint is the only thing that holds.
model Booking {
  id         String @id @default(cuid())
  tenantId   String
  resourceId String

  startTs DateTime @db.Timestamptz(3)
  endTs   DateTime @db.Timestamptz(3)

  /// Either a registered player…
  bookedByUserId String?
  /// …or a guest. A guest booking is a first-class flow, not a degraded one.
  guestEmail     String?
  guestPhone     String?
  guestName      String?

  /// The weekly series this booking is one occurrence of (#364, P44), or
  /// null. Each occurrence is an ordinary booking — the EXCLUDE constraint,
  /// the diary and a single cancel treat it exactly like any other.
  seriesId String?

  status     BookingStatus  @default(PENDING)
  /// How it was made (#380). Every booking before this column existed came
  /// through the player route, so the default backfills them as ONLINE —
  /// which is also what the previous image keeps writing after a rollback.
  channel    BookingChannel @default(ONLINE)
  totalCents Int
  currency   String         @default("EUR")
  /// NOT encrypted and NOT sanitised, and written straight from the request
  /// body with no length cap. Often holds access details — "ring the bell,
  /// gate code 4471" — which is why it was listed in the encrypted-field
  /// manifest that turned out to be wired to nothing.
  notes      String?

  /// Client-generated. A retried request with the same key returns the
  /// ORIGINAL booking rather than creating a second one — the difference
  /// between a flaky network and a double charge.
  idempotencyKey String

  stripePaymentIntentId String?

  /// A PENDING booking holds the slot. Without an expiry, an abandoned
  /// checkout would hold it forever, because the EXCLUDE constraint counts
  /// PENDING as occupying the slot.
  expiresAt DateTime? @db.Timestamptz(3)

  cancelledAt            DateTime?
  cancellationReasonJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource      Resource             @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  participants  BookingParticipant[]
  payments      Payment[]
  refunds       Refund[]
  checkIns      CheckIn[]
  cancellation  Cancellation?
  session       OpenPlaySession?     @relation("SessionBooking")
  bookingSplits BookingSplit[]
  series        BookingSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  inviteLinks   BookingInviteLink[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, resourceId, startTs])
  @@index([tenantId, status])
  @@index([bookedByUserId])
  @@index([resourceId])
  @@index([expiresAt])
  /// The completion sweep: CONFIRMED bookings whose end has passed, across
  /// every club. `status` LEADS because the sweep is cross-tenant and binds no
  /// tenant, so `[tenantId, status]` above cannot serve it — Postgres 16 has no
  /// skip scan, and without this every run is a sequential scan of every
  /// booking ever made. Same reasoning as `expiresAt` for the expiry sweep.
  @@index([status, endTs])
  /// A series' occurrences, for its detail and for "cancel the rest".
  @@index([seriesId, startTs])
  @@map("booking")
}

/// A weekly recurring booking a club enters for a regular customer (#364, Q41).
///
/// The series is the RULE — this court, this weekday, this wall-clock time, this
/// long, from `firstDate` to `lastDate` — and the customer it is for. The
/// occurrences are ordinary `Booking` rows pointing back at it with
/// `seriesId`, each written through `createBooking` and held by the same
/// `booking_no_overlap` constraint, each cancellable on its own.
///
/// The time is a WALL-CLOCK time in `timezone`, not an instant: "Tuesdays at
/// 19:00" is 17:00Z in October and 16:00Z in November, because Sofia leaves
/// summer time in between. Every occurrence's instant is resolved from its own
/// date, so the customer plays at 19:00 on both sides of the change.
///
/// Players cannot create one in v1 (owner decision): every writer is staff
/// holding `bookings.view_all`, and every write is audited.
model BookingSeries {
  id         String @id @default(cuid())
  tenantId   String
  resourceId String

  /// "HH:mm" on the club's clock, and the zone it was entered in.
  startTime       String
  durationMinutes Int
  timezone        String

  /// The first and the last occurrence's calendar date at the club.
  firstDate DateTime @db.Date
  lastDate  DateTime @db.Date

  /// Who it is for: the name and phone the desk took, and — optionally — the
  /// playerz account it is linked to, which puts every occurrence in that
  /// player's Резервации.
  customerName   String
  customerPhone  String
  customerUserId String?

  /// The price staff set for every occurrence, or null for "the server's quote
  /// per occurrence". An override is audited.
  priceCents Int?
  notes      String?

  createdByUserId String?
  /// "Cancel the rest from this date" — the date it was cut at, or null.
  cancelledFrom   DateTime? @db.Date

  /// The desk's retry key, as `Booking.idempotencyKey`: a repeated create
  /// returns the series it made.
  idempotencyKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, resourceId])
  @@index([resourceId])
  @@map("booking_series")
}

model BookingParticipant {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String

  userId     String?
  guestName  String?
  guestEmail String?
  /// 1..court.capacity
  position   Int

  joinedAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  /// A person is on a booking once (P45, #358). Guests (userId NULL) are not
  /// constrained: Postgres treats NULLs as distinct.
  @@unique([bookingId, userId])
  @@index([tenantId])
  @@index([bookingId])
  @@index([userId])
  @@map("booking_participant")
}

/// A shareable link that adds whoever opens it to a booking (#358, P45).
///
/// The token exists once, in the booker's hands: only `hashForLookup(token)`
/// (HMAC-SHA256 with a server key) is stored, so a leaked database yields no
/// working link. A link adds the signed-in person who opens it, while the
/// court has room, until the booking starts (`expiresAt` = `booking.startTs`)
/// or the booker revokes it. Several may be live at once, so sharing again does
/// not break a link already sent; `MAX_LIVE_INVITE_LINKS` bounds them.
model BookingInviteLink {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String

  tokenHash       String
  createdByUserId String

  expiresAt       DateTime  @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  revokedByUserId String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_invite_link")
}

model Payment {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String

  provider      String        @default("STRIPE")
  providerRefId String?
  amountCents   Int
  currency      String        @default("EUR")
  status        PaymentStatus @default(REQUIRES_ACTION)

  paidAt            DateTime?
  failureReasonJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]

  /// One row per provider charge. Added in P28: `skipDuplicates` on the
  /// webhook's Payment write silently did nothing without it — there was an
  /// INDEX on providerRefId but no UNIQUE, so a redelivered event produced a
  /// second PAID row for one charge and the club's books showed double the
  /// money. NULLs do not conflict in Postgres, so a payment with no provider
  /// reference is unaffected.
  @@unique([provider, providerRefId])
  @@index([tenantId])
  @@index([bookingId])
  @@index([providerRefId])
  @@index([tenantId, status])
  @@map("payment")
}

model Refund {
  id        String  @id @default(cuid())
  tenantId  String
  bookingId String
  paymentId String?

  amountCents   Int
  currency      String        @default("EUR")
  reason        String?
  providerRefId String?
  status        PaymentStatus @default(REQUIRES_ACTION)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
  @@index([bookingId])
  @@index([paymentId])
  @@map("refund")
}

model CheckIn {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String

  userId      String?
  checkedInAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@index([userId])
  @@map("check_in")
}

model Cancellation {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String @unique

  cancelledByUserId String?
  reason            String?
  /// Percentage actually refunded, resolved from the venue's policy at the
  /// moment of cancellation — the policy may change later, and a receipt
  /// must not.
  refundPercent     Int     @default(0)
  /// TOTAL refunded across both legs, in cents.
  refundAmountCents Int     @default(0)
  /// The part of that total returned as WALLET CREDIT rather than to a card.
  ///
  /// Recorded separately because the two legs settle through different
  /// systems — the card through Stripe, the wallet through an append-only
  /// ledger entry — and a receipt that only carried the total could not be
  /// reconciled against either. Card part = refundAmountCents - this.
  refundCreditCents Int     @default(0)

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([cancelledByUserId])
  @@map("cancellation")
}
