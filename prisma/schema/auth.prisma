// ── The hybrid tenancy shape — this is the load-bearing decision ─────
//
// A PLAYER is global. One User, one identity, one Glicko-2 rating, playing
// at many venues. If User carried a tenantId, a player joining a second
// club would need a second account and their rating would fork.
//
// A STAFF relationship is per-tenant. TenantMembership carries the
// tenantId, so the same human can be a COACH at one venue and a PLAYER at
// another.
//
// Consequence: `User` and `PlayerProfile` have NO RLS — they are global by
// design. Every OTHER table with a tenantId gets a policy. The
// `rls-coverage` guardrail enforces exactly that, with those two models on
// an explicit allowlist, so "forgot to add a policy" cannot pass review.

model VenueOrg {
  id   String @id @default(cuid())
  slug String @unique
  name String

  logoUrl      String?
  contactEmail String
  contactPhone String?
  addressLine  String?
  city         String?
  country      String  @default("BG")
  timezone     String  @default("Europe/Sofia")
  currency     String  @default("EUR")

  status   TenantStatus @default(ACTIVE)
  planTier PlanTier     @default(FREE)

  // Envelope encryption: the tenant's data-encryption key, itself
  // encrypted with the master key. `previousEncryptedDek` exists so a key
  // rotation can decrypt in-flight rows written under the old DEK.
  encryptedDek         String?
  previousEncryptedDek String?

  // ── Stripe Connect ──────────────────────────────────────────────
  //
  // `payoutsEnabled` is NOT a convenience flag we set when onboarding
  // "looks done". It mirrors what Stripe told us in `account.updated`.
  //
  // Stripe refuses a destination charge to an account that cannot receive
  // payouts, so charging against an un-onboarded venue fails AFTER the
  // customer has entered their card — they see a card error for a problem
  // that is entirely the club's. We check this before checkout instead.
  stripeAccountId String?
  payoutsEnabled  Boolean @default(false)

  // The venue's OWN subscription to us (Stripe Billing), which sets planTier
  // and therefore the commission bps. Distinct from stripeAccountId, which is
  // the connected account we pay OUT to.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // E2E cleanup marker — an isolated-tenant fixture stamps its run id here
  // so teardown is unambiguous even when a spec crashes mid-way.
  tenantTestRun String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      TenantMembership[]
  sessions         UserSession[]
  invites          Invite[]
  customRoles      TenantCustomRole[]
  apiKeys          ApiKey[]
  securitySettings TenantSecuritySettings?

  @@index([city, country, status])
  @@index([tenantTestRun])
  @@map("venue_org")
}

/// GLOBAL identity. No tenantId — deliberately. See the header note.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  name          String?
  phone         String?
  avatarUrl     String?
  locale        Locale    @default(bg)

  /// Bumped to invalidate every issued session (password change, forced
  /// logout). A JWT carrying a stale version is rejected.
  sessionVersion Int @default(0)

  /// NOT encrypted, and nothing writes it. MFA is unimplemented: the string
  /// "mfaSecret" appeared in exactly one other place in src/, a manifest that
  /// was never wired to anything and has been removed. Whoever implements MFA
  /// must encrypt this on the way in — a plaintext TOTP seed defeats the
  /// entire second factor — and there is no mechanism waiting to do it.
  mfaSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     PlayerProfile?
  memberships TenantMembership[]
  sessions    UserSession[]
  resetTokens PasswordResetToken[]
  invitesSent Invite[]             @relation("InvitedBy")
  apiKeys     ApiKey[]
  invitedBy   TenantMembership[]   @relation("MembershipInvitedBy")

  /// Platform authority, if any. Almost always empty — see platform.prisma for
  /// why this is a grant row rather than a value in `enum Role` or a flag here.
  platformGrants PlatformAdminGrant[] @relation("PlatformGrantHolder")

  @@map("app_user")
}

/// GLOBAL, 1:1 with User. A player's rating follows the player, not the club.
model PlayerProfile {
  userId String @id

  displayName String
  /// Sports this player actually plays — drives matchmaking eligibility.
  sports      SportType[]

  /// Per-sport Glicko-2 state: { TENNIS: { mu, phi, sigma, matchesPlayed } }.
  /// Json rather than a table because it is read as a unit, written as a
  /// unit, and never queried across players by a single sport's mu.
  skillRatingsJson Json @default("{}")

  /// NOT encrypted and NOT sanitised today. Free text a stranger will read is
  /// both a PII surface and an XSS surface, so it must be sanitised on write
  /// before anything renders it.
  bio           String?
  dateOfBirth   DateTime?
  preferredHand String?
  skillLevel    SkillLevel @default(BEGINNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profile")
}

model TenantMembership {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  role         Role             @default(PLAYER)
  customRoleId String?
  status       MembershipStatus @default(INVITED)

  invitedById   String?
  acceptedAt    DateTime?
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     VenueOrg          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole TenantCustomRole? @relation(fields: [customRoleId], references: [id])
  invitedBy  User?             @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([customRoleId])
  @@index([invitedById])
  @@map("tenant_membership")
}

/// tenantId is NULLABLE — a session exists between sign-in and tenant
/// selection. That makes its RLS policy asymmetric: you may READ your own
/// pre-tenant session (tenantId IS NULL), but you may never WRITE a row
/// into another tenant.
model UserSession {
  id       String  @id @default(cuid())
  userId   String
  tenantId String?

  /// Binds the ACCESS token to this row. Deliberately never rotated — see
  /// refreshTokenHash.
  tokenHash      String    @unique
  sessionVersion Int       @default(0)
  ipAddress      String?
  userAgent      String?
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  /// ─── NATIVE REFRESH, AND WHY IT IS A SEPARATE SLOT ───────────────
  ///
  /// A native access token is short (minutes) because the EDGE middleware
  /// never checks revocation — it reads the JWT and inspects claims, and
  /// `checkSession` only runs inside a route. So `exp` is the only
  /// revocation the edge honours, and a long access token is a long window
  /// in which a revoked session still passes the tenant and permission
  /// checks.
  ///
  /// The refresh token is long-lived and ROTATES on every use, which is how
  /// a stolen one is detected: presenting a token that was already rotated
  /// away means two parties hold it.
  ///
  /// It cannot reuse `tokenHash`. That column binds the ACCESS token's
  /// embedded secret, so rotating it would invalidate every access token
  /// already in flight — which is precisely the logout cannon this design
  /// exists to avoid. Rotating only this column leaves those alone.
  refreshTokenHash String? @unique

  /// ─── THE GRACE WINDOW ────────────────────────────────────────────
  ///
  /// An iOS app resumed from the switcher fires several requests at once.
  /// All of them 401, all of them call /auth/refresh with the SAME token
  /// within milliseconds. Strict rotation says the second one is a replay
  /// and kills the session — a user logged out for using their phone
  /// normally.
  ///
  /// So the previous token stays acceptable for a short window after
  /// rotation. Inside it, a request gets a fresh access token and the
  /// CURRENT refresh token back, so every concurrent caller converges on
  /// the same value instead of racing to rotate again.
  ///
  /// Presenting it AFTER the window has closed is the real replay signal.
  previousRefreshTokenHash String?
  previousRefreshExpiresAt DateTime?

  createdAt DateTime @default(now())

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant VenueOrg? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  /// The grace-window lookup. Not unique: two rows may briefly hold the same
  /// previous hash only if a hash collided, which the HMAC makes impossible —
  /// but a plain index is what the query needs and a unique constraint here
  /// would turn a collision into a write failure rather than a lookup miss.
  @@index([previousRefreshTokenHash])
  @@map("user_session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model Invite {
  id       String @id @default(cuid())
  tenantId String

  email        String
  role         Role    @default(PLAYER)
  customRoleId String?
  tokenHash    String  @unique

  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant    VenueOrg @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("invite")
}

model TenantSecuritySettings {
  id       String @id @default(cuid())
  tenantId String @unique

  maxConcurrentSessions Int @default(5)
  sessionMaxAgeMinutes  Int @default(43200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant VenueOrg @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_security_settings")
}

model TenantCustomRole {
  id       String @id @default(cuid())
  tenantId String

  name        String
  permissions Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      VenueOrg           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tenant_custom_role")
}

model ApiKey {
  id       String @id @default(cuid())
  tenantId String

  name            String
  tokenHash       String    @unique
  createdByUserId String?
  permissions     Json      @default("[]")
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  tenant    VenueOrg @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id])

  @@index([tenantId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@map("api_key")
}
