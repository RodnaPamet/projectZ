// ── The hybrid tenancy shape — this is the load-bearing decision ─────
//
// A PLAYER is global. One User, one identity, one Glicko-2 rating, playing
// at many venues. If User carried a tenantId, a player joining a second
// club would need a second account and their rating would fork.
//
// A STAFF relationship is per-tenant. TenantMembership carries the
// tenantId.
//
// ── One account, one kind (#263) ────────────────────────────────────
//
// This used to say "so the same human can be a COACH at one venue and a
// PLAYER at another". The owner decided otherwise: an account is a PLAYER, a
// CLUB account (one club) or a COACH, and doing two of those takes two
// accounts. `User.accountKind` says which, and a trigger on tenant_membership
// holds every ACTIVE membership to it — see the p37 migration.
//
// Consequence: `User` and `PlayerProfile` have NO RLS — they are global by
// design. Every OTHER table with a tenantId gets a policy. The
// `rls-coverage` guardrail enforces exactly that, with those two models on
// an explicit allowlist, so "forgot to add a policy" cannot pass review.

model VenueOrg {
  id   String @id @default(cuid())
  slug String @unique
  name String

  logoUrl      String?
  contactEmail String
  contactPhone String?
  addressLine  String?
  city         String?
  country      String  @default("BG")
  timezone     String  @default("Europe/Sofia")
  currency     String  @default("EUR")

  status   TenantStatus @default(ACTIVE)
  planTier PlanTier     @default(FREE)

  // Envelope encryption: the tenant's data-encryption key, itself
  // encrypted with the master key. `previousEncryptedDek` exists so a key
  // rotation can decrypt in-flight rows written under the old DEK.
  encryptedDek         String?
  previousEncryptedDek String?

  // ── Stripe Connect ──────────────────────────────────────────────
  //
  // `payoutsEnabled` is NOT a convenience flag we set when onboarding
  // "looks done". It mirrors what Stripe told us in `account.updated`.
  //
  // Stripe refuses a destination charge to an account that cannot receive
  // payouts, so charging against an un-onboarded venue fails AFTER the
  // customer has entered their card — they see a card error for a problem
  // that is entirely the club's. We check this before checkout instead.
  stripeAccountId String?
  payoutsEnabled  Boolean @default(false)

  /// Whether players PAY ONLINE when they book here (#354). Off by default and
  /// off for every club in the Sofia pilot: a booking is CONFIRMED the moment
  /// it is made and paid at the club, and `POST …/checkout` refuses.
  ///
  /// On, a booking is created PENDING with a 15-minute hold and is confirmed
  /// by checkout — the Stripe flow, kept intact behind this flag rather than
  /// deleted. Nothing in the app sets it; it is an operator's decision.
  onlinePaymentEnabled Boolean @default(false)

  /// The most upcoming ONLINE bookings one player may hold at this club at
  /// once (#380). Default 3; 1..50 by CHECK (`venue_org_max_upcoming_online_
  /// bookings_range`). Desk bookings and recurring series are not counted and
  /// never limited. Set by an OWNER or MANAGER on the pricing screen, audited.
  maxUpcomingOnlineBookings Int @default(3)

  // The venue's OWN subscription to us (Stripe Billing), which sets planTier
  // and therefore the commission bps. Distinct from stripeAccountId, which is
  // the connected account we pay OUT to.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // E2E cleanup marker — an isolated-tenant fixture stamps its run id here
  // so teardown is unambiguous even when a spec crashes mid-way.
  tenantTestRun String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      TenantMembership[]
  sessions         UserSession[]
  invites          Invite[]
  customRoles      TenantCustomRole[]
  apiKeys          ApiKey[]
  securitySettings TenantSecuritySettings?

  @@index([city, country, status])
  @@index([tenantTestRun])
  /// Serves `ORDER BY createdAt, id` — the stable order the platform club list
  /// pages through. Measured on 50 000 rows: without it, page one is a
  /// sequential scan plus a top-N heapsort at 87 ms; with it, an index-only
  /// scan with no sort at 0.3 ms.
  ///
  /// `id` is in the index because it is in the ORDER BY, and it is in the
  /// ORDER BY because `createdAt` is not unique — a non-unique sort key makes
  /// a cursor skip rows. See src/app/api/v1/platform/tenants/route.ts.
  @@index([createdAt, id])
  @@map("venue_org")
}

/// GLOBAL identity. No tenantId — deliberately. See the header note.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  name          String?
  phone         String?
  avatarUrl     String?
  locale        Locale    @default(bg)

  /// Which emails this person wants (#367, Q22). The bell always gets
  /// everything; these switch only the email. On by default.
  emailBookingConfirmations Boolean @default(true)
  emailBookingReminders     Boolean @default(true)
  emailClubChanges          Boolean @default(true)

  /// Bumped to invalidate every issued session (password change, forced
  /// logout). A JWT carrying a stale version is rejected.
  sessionVersion Int @default(0)

  /// What this account IS (#263): PLAYER, CLUB or COACH. See `enum AccountKind`.
  ///
  /// PLAYER by default, because every way an account comes into being today is
  /// a sign-in with no memberships — and that is a player. It becomes CLUB when
  /// it is made a club's owner (`create-venue-org`) or accepts a staff invite
  /// while still empty; nothing makes it COACH yet.
  ///
  /// NULL means UNDECIDED, and only the p37 migration writes it: an account
  /// that held club roles at two or more clubs, or a COACH role, when the kinds
  /// arrived. Nothing is inferred for those — `scripts/report-undecided-accounts.ts`
  /// lists them for a person to settle — and every path that grants something
  /// refuses them until then.
  ///
  /// ENFORCED BY THE DATABASE, not only here: `account_kind_membership_trg`
  /// refuses an ACTIVE membership whose role the kind does not allow, and a
  /// second club for a CLUB account. The `lastContext` column that stood here
  /// (#227's role switcher) is gone with the switcher: one kind has nothing to
  /// switch between.
  accountKind AccountKind? @default(PLAYER)

  /// Encrypted at rest (#262): the TOTP shared secret, as the `v1:`
  /// AES-256-GCM envelope from src/lib/security/encryption.ts — `encryptField`
  /// on the way in, `decryptField` on the way out, both in
  /// src/lib/auth/mfa.ts and nowhere else. A CHECK
  /// (`app_user_mfa_secret_is_envelope`, P38) refuses any value that is not
  /// the envelope, so a plaintext seed is an error at write time.
  ///
  /// Set when enrolment STARTS; the enrolment is pending until `mfaEnabledAt`.
  mfaSecret String?

  /// When the first code was confirmed. Null = not enrolled (or pending). A
  /// pending secret is never accepted for a step-up.
  mfaEnabledAt DateTime?

  /// The 30-second TOTP step last accepted. A code is only accepted for a
  /// step strictly after this, so a code cannot be replayed inside its window.
  mfaLastUsedStep BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     PlayerProfile?
  memberships TenantMembership[]
  sessions    UserSession[]
  resetTokens PasswordResetToken[]
  invitesSent Invite[]             @relation("InvitedBy")
  apiKeys     ApiKey[]
  emailOutbox EmailOutbox[]
  invitedBy   TenantMembership[]   @relation("MembershipInvitedBy")

  mfaRecoveryCodes MfaRecoveryCode[]

  /// Platform authority, if any. Almost always empty — see platform.prisma for
  /// why this is a grant row rather than a value in `enum Role` or a flag here.
  platformGrants PlatformAdminGrant[] @relation("PlatformGrantHolder")

  /// The sports this person plays, each at a level they declared (#359).
  sportLevels PlayerSportLevel[]

  @@map("app_user")
}

/// A sport a player plays, at the level they say they play it (#359, Q37).
///
/// SELF-DECLARED, 1 to 7: 1 is "just starting", 7 is "competitor". It is the
/// starting point the rankings module (#378) will take over from, not a rating:
/// `PlayerProfile.skillRatingsJson` holds what matches prove. The range is a
/// CHECK in the database (`player_sport_level_range`, P43), so a write that
/// skipped the zod schema still cannot store an 8.
///
/// OWN ROWS ONLY, by RLS keyed on `app.user_id` (P43), as push subscriptions
/// are: written and read through `runAsUserOnly`. Keyed to the USER, not to
/// `PlayerProfile`, because a profile row needs a display name and most
/// accounts have none; a person can say they play padel before they have
/// told us what to call them.
model PlayerSportLevel {
  userId String
  sport  SportType
  level  Int       @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sport])
  @@map("player_sport_level")
}

/// GLOBAL, 1:1 with User. A player's rating follows the player, not the club.
model PlayerProfile {
  userId String @id

  displayName String
  /// Sports this player actually plays — drives matchmaking eligibility.
  sports      SportType[]

  /// Per-sport Glicko-2 state: { TENNIS: { mu, phi, sigma, matchesPlayed } }.
  /// Json rather than a table because it is read as a unit, written as a
  /// unit, and never queried across players by a single sport's mu.
  skillRatingsJson Json @default("{}")

  /// NOT encrypted and NOT sanitised today. Free text a stranger will read is
  /// both a PII surface and an XSS surface, so it must be sanitised on write
  /// before anything renders it.
  bio           String?
  dateOfBirth   DateTime?
  preferredHand String?
  skillLevel    SkillLevel @default(BEGINNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profile")
}

/// One person's standing at one club.
///
/// ─── The role must fit the account (#263) ───────────────────────────
///
/// An ACTIVE row is held to its user's `accountKind` by a trigger the p37
/// migration installs (`account_kind_membership_trg`), not by the application:
///
///   PLAYER account   PLAYER rows only
///   CLUB account     OWNER / MANAGER / STAFF rows only, at ONE club
///   COACH account    COACH rows only
///
/// Prisma cannot model a trigger, so it lives in SQL and `migration-safety`
/// refuses a migration that drops it. Rows that are not ACTIVE are history and
/// are not held to anything — the migration keeps a club account's old PLAYER
/// rows, EXPIRED, so its bookings still have a membership behind them.
model TenantMembership {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  role         Role             @default(PLAYER)
  customRoleId String?
  status       MembershipStatus @default(INVITED)

  invitedById   String?
  acceptedAt    DateTime?
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     VenueOrg          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole TenantCustomRole? @relation(fields: [customRoleId], references: [id])
  invitedBy  User?             @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([customRoleId])
  @@index([invitedById])
  @@map("tenant_membership")
}

/// tenantId is NULLABLE — a session exists between sign-in and tenant
/// selection. That makes its RLS policy asymmetric: you may READ your own
/// pre-tenant session (tenantId IS NULL), but you may never WRITE a row
/// into another tenant.
model UserSession {
  id       String  @id @default(cuid())
  userId   String
  tenantId String?

  /// Binds the ACCESS token to this row. Deliberately never rotated — see
  /// refreshTokenHash.
  tokenHash      String    @unique
  sessionVersion Int       @default(0)
  ipAddress      String?
  userAgent      String?
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  /// ─── NATIVE REFRESH, AND WHY IT IS A SEPARATE SLOT ───────────────
  ///
  /// A native access token is short (minutes) because the EDGE middleware
  /// never checks revocation — it reads the JWT and inspects claims, and
  /// `checkSession` only runs inside a route. So `exp` is the only
  /// revocation the edge honours, and a long access token is a long window
  /// in which a revoked session still passes the tenant and permission
  /// checks.
  ///
  /// The refresh token is long-lived and ROTATES on every use, which is how
  /// a stolen one is detected: presenting a token that was already rotated
  /// away means two parties hold it.
  ///
  /// It cannot reuse `tokenHash`. That column binds the ACCESS token's
  /// embedded secret, so rotating it would invalidate every access token
  /// already in flight — which is precisely the logout cannon this design
  /// exists to avoid. Rotating only this column leaves those alone.
  refreshTokenHash String? @unique

  /// ─── THE GRACE WINDOW ────────────────────────────────────────────
  ///
  /// An iOS app resumed from the switcher fires several requests at once.
  /// All of them 401, all of them call /auth/refresh with the SAME token
  /// within milliseconds. Strict rotation says the second one is a replay
  /// and kills the session — a user logged out for using their phone
  /// normally.
  ///
  /// So the previous token stays acceptable for a short window after
  /// rotation. Inside it, a request gets a fresh access token and the
  /// CURRENT refresh token back, so every concurrent caller converges on
  /// the same value instead of racing to rotate again.
  ///
  /// Presenting it AFTER the window has closed is the real replay signal.
  previousRefreshTokenHash String?
  previousRefreshExpiresAt DateTime?

  /// When THIS session last proved the second factor (#262). The step-up that
  /// every cross-club write requires is read from here, inside the write's own
  /// transaction, and is bound to this row: revoking the session ends it, and
  /// another session of the same person has its own. See
  /// MFA_STEP_UP_WINDOW_SECONDS for how long it lasts.
  mfaVerifiedAt DateTime?

  createdAt DateTime @default(now())

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant VenueOrg? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  /// The grace-window lookup. Not unique: two rows may briefly hold the same
  /// previous hash only if a hash collided, which the HMAC makes impossible —
  /// but a plain index is what the query needs and a unique constraint here
  /// would turn a collision into a write failure rather than a lookup miss.
  @@index([previousRefreshTokenHash])
  @@map("user_session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model Invite {
  id       String @id @default(cuid())
  tenantId String

  email        String
  role         Role    @default(PLAYER)
  customRoleId String?
  tokenHash    String  @unique

  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant    VenueOrg @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("invite")
}

model TenantSecuritySettings {
  id       String @id @default(cuid())
  tenantId String @unique

  maxConcurrentSessions Int @default(5)
  sessionMaxAgeMinutes  Int @default(43200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant VenueOrg @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_security_settings")
}

model TenantCustomRole {
  id       String @id @default(cuid())
  tenantId String

  name        String
  permissions Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      VenueOrg           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tenant_custom_role")
}

model ApiKey {
  id       String @id @default(cuid())
  tenantId String

  name            String
  tokenHash       String    @unique
  createdByUserId String?
  permissions     Json      @default("[]")
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  tenant    VenueOrg @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id])

  @@index([tenantId])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@map("api_key")
}

/// A single-use recovery code for a lost authenticator (#262).
///
/// SHA-256 of an 80-bit code, salted with the user id — see
/// src/lib/auth/totp.ts for why that needs no server key. Spent by setting
/// `usedAt` with `WHERE usedAt IS NULL`, so a race cannot spend one twice.
/// Denied to app_user; read and written only by src/lib/auth/mfa.ts.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_code")
}

/// What happened to a person's second factor: enrolment, every step-up that
/// succeeded or failed, every recovery code spent (#262).
///
/// Append-only by trigger, no FK on userId (the record outlives the account),
/// denied to app_user. Not `platform_audit_entry` — that row records a grant's
/// capability being exercised, and enrolling a phone exercises none.
model AccountSecurityEvent {
  id            String   @id @default(cuid())
  userId        String
  userSessionId String?
  /// SCREAMING_SNAKE verb from MFA_EVENTS in src/lib/auth/mfa.ts.
  action        String
  detailsJson   Json     @default("{}")
  requestId     String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("account_security_event")
}
