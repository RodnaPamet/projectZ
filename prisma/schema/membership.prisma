/// The player's standing AT a venue. Tenant-scoped on purpose — no-show count
/// is the club's business, not the player's global identity.
///
/// Credit does NOT live here. It lives in [CreditLedgerEntry], which is
/// append-only. A mutable `creditBalanceCents` column on this model was
/// removed in P16: a balance you can UPDATE cannot be reconstructed or
/// disputed, and two wallets in one codebase means someone eventually reads
/// the wrong one.
model PlayerVenueRelationship {
  id       String @id @default(cuid())
  tenantId String

  playerUserId String

  tags         String[]
  /// Every no-show ever recorded here. A running total for the club's eyes;
  /// the BLOCK is not computed from it (see below).
  noShowCount  Int       @default(0)
  lastPlayedAt DateTime?

  /// Staff lifted the no-show block (#354). No-shows on bookings that started
  /// at or before this instant no longer count towards it. The block itself is
  /// never stored: it is "3+ NO_SHOW bookings in the last 90 days, after this",
  /// counted from `booking` at the moment of booking — see `noShowStanding`.
  noShowBlockClearedAt       DateTime? @db.Timestamptz(3)
  /// Who lifted it. The audit row (PLAYER_NO_SHOW_BLOCK_CLEARED) is the full
  /// record; this is what the players screen shows without reading the log.
  noShowBlockClearedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, playerUserId])
  @@index([tenantId])
  @@index([playerUserId])
  @@map("player_venue_relationship")
}

/// A deleted account's no-show standing at a club, waiting for the next
/// account made with the same address (#370 review; owner decision
/// 2026-10-08, "carry the no-show block over"). One row per no-show that still
/// counted when the account was deleted, and only then: an account with no
/// standing anywhere leaves nothing here.
///
/// `fingerprint` is a keyed HMAC of the address (src/lib/account/
/// no-show-fingerprint.ts), never the address. A sign-in to an account with
/// that address sets `inheritedByUserId`, and from then on the club's standing
/// for that account counts the row (`noShowStanding`), exactly as the deleted
/// account's would have. Every row is dropped once its no-show stops counting,
/// 90 days after `startedAt` (`purgeLapsedNoShowCarries`, run by the
/// completion sweep). Tags and history are not carried.
model NoShowCarry {
  id                String   @id @default(cuid())
  tenantId          String
  fingerprint       String
  /// The tombstone it came from.
  deletedUserId     String
  /// The account that took it over, once one exists.
  inheritedByUserId String?
  /// When the missed booking started: it counts for 90 days from here.
  startedAt         DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now())

  @@index([fingerprint])
  @@index([tenantId, inheritedByUserId])
  @@index([inheritedByUserId])
  @@index([startedAt])
  @@map("no_show_carry")
}

model Membership {
  id       String @id @default(cuid())
  tenantId String

  playerUserId String
  level        String
  priceCents   Int
  currency     String           @default("EUR")
  startsAt     DateTime
  endsAt       DateTime
  autoRenew    Boolean          @default(false)
  status       MembershipStatus @default(ACTIVE)

  /// Set when the membership is billed through Stripe Billing rather than sold
  /// as a one-off. Unique: two memberships pointing at one subscription would
  /// both flip to ACTIVE on a single `invoice.paid`.
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, playerUserId, level])
  @@index([tenantId, status])
  @@index([playerUserId])
  @@index([endsAt])
  @@map("membership")
}

model SeasonPass {
  id       String @id @default(cuid())
  tenantId String

  playerUserId  String
  name          String
  totalSessions Int
  usedSessions  Int      @default(0)
  priceCents    Int
  currency      String   @default("EUR")
  validFrom     DateTime
  validUntil    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([playerUserId])
  @@index([validUntil])
  @@map("season_pass")
}
