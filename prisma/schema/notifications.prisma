enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationKind {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  SESSION_FULL
  MESSAGE_RECEIVED
  MATCH_RESULT
  ACHIEVEMENT_UNLOCKED
  TOURNAMENT_ROUND
  PAYMENT_RECEIVED
  SPLIT_REQUESTED
  /// #367/#416: who is playing changed. Bell only, never email.
  BOOKING_PLAYER_JOINED
  BOOKING_PLAYER_LEFT
  BOOKING_PLAYER_ADDED
  BOOKING_PLAYER_REMOVED
  /// #369: a club asked about playerz through the landing page's form.
  /// Email only, to the operator's inbox (`CONTACT_INBOX_EMAIL`); no bell.
  CONTACT_REQUEST
}

/// Where an email stands in the outbox (#367).
enum EmailOutboxStatus {
  /// Waiting for its first send, or for its next retry at `nextAttemptAt`.
  PENDING
  /// Accepted by the provider (or written to the log by the log-only adapter).
  SENT
  /// Not sent, on purpose: the booking was cancelled or has started, the
  /// person turned the category off or has no address, or it expired.
  SKIPPED
  /// Failed `EMAIL_MAX_ATTEMPTS` times, or refused permanently. Kept for a
  /// person to look at; nothing retries it.
  DEAD
}

/// A browser's push endpoint.
///
/// One row per DEVICE, not per user — a person with a phone and a laptop has two,
/// and a notification goes to both.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  /// The push service URL. Unique: the SAME browser re-subscribing must update
  /// its row rather than accumulate a second one, or every notification is
  /// delivered twice to the same device.
  endpoint String @unique

  /// The browser's public key and auth secret, used to ENCRYPT the payload.
  /// Without them the push service could read every notification we send.
  p256dh String
  auth   String

  userAgent String?

  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  /// Consecutive failures. A push endpoint that has been failing for a long time
  /// is a device that is gone — see `pruneDeadSubscriptions`.
  failureCount  Int       @default(0)

  @@index([userId])
  @@map("push_subscription")
}

/// An in-app notification. The notification CENTRE is the source of truth;
/// push is a delivery mechanism on top of it.
///
/// Same discipline as messaging (P15): PERSIST, THEN PUSH. A push that fires
/// before the row exists shows the user something they cannot then find.
model Notification {
  id       String  @id @default(cuid())
  tenantId String?

  userId String
  kind   NotificationKind

  title String
  body  String

  /// Where tapping it goes.
  href String?

  /// What it is about, so the UI can group or supersede.
  refType String?
  refId   String?

  readAt DateTime?

  /// The event this is about, for this recipient (#367): `booking:<id>:confirmed`,
  /// `booking:<id>:reminder`. Unique per user, so a retried hook or a second
  /// cron run writes nothing. NULL for rows from before P46.
  dedupeKey String?

  createdAt DateTime @default(now())

  /// One event, one row per recipient.
  @@unique([userId, dedupeKey])
  /// The bell's page: one user's notifications, newest first, keyset on id.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  /// The unread count.
  @@index([userId, readAt, createdAt])
  @@index([tenantId])
  @@index([refType, refId])
  @@map("notification")
}

/// An email waiting to go out (#367): the OUTBOX.
///
/// Written in the same transaction as the bell's `notification` row, after the
/// booking (or cancel, or join) has committed. A cron drains it through the
/// provider adapter (`src/lib/email/provider.ts`): Resend, SMTP, or the
/// log-only adapter when neither is configured or this is staging.
///
/// The copy is rendered when the row is written, in the RECIPIENT's language,
/// so a retry sends exactly what the first attempt would have. The ADDRESS is
/// not stored: it is read from `user.email` at send time, so a changed address
/// is honoured and a deleted account gets nothing.
///
/// Owner-only under RLS (`app.user_id`), like `notification`; the drain is
/// machine work and binds BYPASSRLS.
///
/// One kind of row has NO user (#369, P50): category `contact`, a landing-page
/// enquiry for the operator. Its address is not stored either: the drain reads
/// `CONTACT_INBOX_EMAIL` at send time, and skips the row when that is unset. A
/// CHECK keeps `userId` NULL to that category alone; such a row is invisible
/// to `app_user` (the owner policy never matches NULL) and is written and
/// drained BYPASSRLS.
model EmailOutbox {
  id        String           @id @default(cuid())
  /// NULL only for category `contact` (CHECK `email_outbox_user_or_contact`).
  userId    String?
  kind      NotificationKind
  /// The settings category it is sent under: `confirmation`, `reminder` or
  /// `clubChanges` (and later `messages`). Re-checked at send time.
  category  String
  /// Same discipline as `notification.dedupeKey`: once per event per person.
  /// Messages (#375) will use `message:<conversation>:<day>` for the
  /// once-a-day cap.
  dedupeKey String
  locale    Locale

  subject String
  /// Plain text only: no HTML, so no tracking pixel and nothing to inject into.
  text    String

  refType String?
  refId   String?

  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  /// When the drain may next pick it up. Also the LEASE: a drain that claims
  /// the row pushes this forward, so a crashed send is retried, not lost.
  nextAttemptAt DateTime          @default(now()) @db.Timestamptz(3)
  /// After this it is SKIPPED rather than sent (a reminder after the start).
  expiresAt     DateTime?         @db.Timestamptz(3)
  lastError     String?
  provider      String?
  sentAt        DateTime?         @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deleting an account deletes its unsent mail (and the copy it carries).
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// NULLs are distinct here, so a `contact` row's dedupe key is unique by the
  /// partial index `email_outbox_contact_dedupeKey_key` (P50) instead.
  @@unique([userId, dedupeKey])
  /// The drain: what is due, oldest first.
  @@index([status, nextAttemptAt])
  @@index([refType, refId])
  @@map("email_outbox")
}

/// An enquiry from the landing page's "For clubs" form (#369).
///
/// Written by an ANONYMOUS visitor, so it belongs to no user and no club:
/// `app_user` may neither read nor write it (deny-all policy), the form's
/// Server Action writes it BYPASSRLS, and the platform reads it through
/// `asPlatformAdmin` under CONTACT_READ, audited.
///
/// The visitor's IP is NOT stored, here or anywhere: the form's rate limit is
/// keyed on a keyed hash of it, in Redis, for the window only.
model ContactRequest {
  id       String  @id @default(cuid())
  name     String
  clubName String
  /// At least one of the two (CHECK `contact_request_reachable`).
  phone    String?
  email    String?
  message  String
  /// The language the visitor read the form in, so the reply can match it.
  locale   Locale

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// The platform list: newest first, keyset on (createdAt, id).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("contact_request")
}
