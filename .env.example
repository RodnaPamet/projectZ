# ─── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# ─── Data ────────────────────────────────────────────────────────────
# ─── Two URLs, and the difference is the whole point ─────────────────
#
# DATABASE_URL is the RUNTIME connection. In production it must name
# `playerz_app` (created by migration P24): a login role that is not a
# superuser, does not own any table, and does NOT inherit its memberships.
# A query issued outside runInTenantContext/runAsSuperuser then fails with
# "permission denied for table …" instead of quietly returning every
# tenant's rows.
#
# DIRECT_DATABASE_URL is for MIGRATIONS, which must own the tables.
# prisma.config.ts already prefers it and falls back to DATABASE_URL.
# Pointing runtime at playerz_app WITHOUT setting this breaks
# `prisma migrate deploy`, because playerz_app cannot create a table.
#
# Set the role's password out of band — it is deliberately not in the
# migration:
#   ALTER ROLE playerz_app PASSWORD '<from the secret store>';
#
# Local dev keeps the owner for both, so seeding and psql stay convenient.
# That also means RLS IS NOT ENFORCED LOCALLY: `playerz` is a cluster
# superuser, and superusers are exempt from row security entirely.
DATABASE_URL=postgresql://playerz:playerz@localhost:5432/playerz
# DIRECT_DATABASE_URL=postgresql://playerz:playerz@localhost:5432/playerz
REDIS_URL=redis://localhost:6379

# ─── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Mail ────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=no-reply@playerz.bg
SMTP_URL=smtp://localhost:1025

# ─── Observability ───────────────────────────────────────────────────
SENTRY_DSN=

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-master-key-not-a-secret # pragma: allowlist secret

CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=dev-api-key # pragma: allowlist secret
CENTRIFUGO_TOKEN_SECRET=dev-token-secret # pragma: allowlist secret

# ── Identity providers ───────────────────────────────────────────────
#
# Neither of these was listed here before, so a fresh clone could not start
# either provider and the failure surfaced as a blank sign-in page rather than
# as a missing variable.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (next-auth v4 provider id: `azure-ad`).
#
# The callback URL to register is:
#   <NEXTAUTH_URL>/api/auth/callback/azure-ad
#
# MICROSOFT_TENANT_ID is the DIRECTORY tenant — a GUID, or `common` to accept
# any Microsoft account. Group mappings are per-club and live in the database,
# never here: a group id in source would be one customer's configuration baked
# into a public repository.
#
# The `groups` claim is NOT produced by the scope this app requests. It has to
# be turned on in the app registration's Token configuration (add the groups
# claim, security groups). Without it a user's group list is empty and no role
# is assigned — which looks identical to "in no mapped group".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Scheduled jobs ───────────────────────────────────────────────────
#
# Shared secret for POST /api/cron/release-expired-bookings, which releases
# slots held by checkouts nobody finished.
#
# That endpoint sits OUTSIDE /api/t/, so the tenant guard, the permission
# table and the route-permission guardrail all decline to cover it — this
# secret is its entire security boundary. Unset, the route returns 503 rather
# than running unguarded.
#
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ── Realtime (Centrifugo) ────────────────────────────────────────────
#
# Shared secret for Centrifugo's SUBSCRIBE PROXY, which calls
# POST /api/v1/realtime/subscribe to ask whether a user may join a channel.
#
# That endpoint sits outside /api/t/, so the tenant guard, the permission
# table and route-permission-coverage all decline to cover it — this secret is
# its entire security boundary. Unset, it refuses EVERY subscription rather
# than allowing them.
#
# Centrifugo must be configured to send it as `x-centrifugo-secret`.
# Generate with: openssl rand -base64 32
CENTRIFUGO_PROXY_SECRET=

# The websocket URL the client connects to. Public by definition — it ships in
# the app binary either way; returned by /api/v1/realtime/token so a client
# does not need a second config call or a rebuild to follow a move.
NEXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket

