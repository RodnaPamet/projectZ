node_modules/
.next/
out/
build/
coverage/
playwright-report/
test-results/
# Visual baselines are per-PLATFORM. CI runs linux and those PNGs are tracked;
# a developer running the suite on a Mac generates -darwin twins that nothing
# compares against and that nobody should commit.
tests/**/*-snapshots/*-darwin.png
.env
.env.local
.env.test

# Signing keys. Apple's APNs key downloads as AuthKey_XXXXXXXXXX.p8 and lands
# in whatever directory the browser chose — frequently this one. A committed
# .p8 is a permanent push credential for the whole app, and it cannot be
# rotated without invalidating every provider using it.
*.p8
*.pem
*.key
*.log
.DS_Store

# typescript
*.tsbuildinfo
next-env.d.ts

# Stockfish (GPL-3). Fetched by scripts/fetch-stockfish.sh, never committed —
# a GPL-3 binary sitting in a proprietary repo invites exactly the confusion the
# arms-length arrangement exists to avoid. See public/engine/README.md.
public/engine/stockfish.js
public/engine/stockfish.wasm
public/engine/LICENSE

