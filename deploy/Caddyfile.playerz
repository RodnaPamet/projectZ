# playerz.bg — appended to /opt/agrent/Caddyfile on the shared VM.
#
# Kept here, in the repo, because a site block that exists only on a box is a
# configuration nobody can review and nobody can restore.
#
# ═══ DNS AND TLS — BOTH LIVE AS OF 2026-09-27 ═══
#
# The domain resolves and the certificate is issued. MEASURED, not assumed:
#
#   playerz.bg        A  35.187.80.26
#   app.playerz.bg    A  35.187.80.26
#   www.playerz.bg    CNAME playerz.bg -> 35.187.80.26
#   zone              ns1/ns2.jumphosting01.com (jump.bg), SOA serial 2026092704
#
#   cert  CN = app.playerz.bg, Let's Encrypt, 2026-09-27 15:35 -> 2026-12-26
#         `curl` verifies the chain (ssl_verify_result=0)
#
# ═══ playerz.bg IS THE PRIMARY HOST — SINCE 2026-10-07 (#369, Q47) ═══
#
# The app is served on playerz.bg; app.playerz.bg and www.playerz.bg redirect to
# it. The redirect is a 302 on purpose while the move settles: a permanent one is
# cached by browsers, and the old playerz.bg -> app.playerz.bg 301 that some
# browsers still hold is exactly why (clear it, or use a private window, if a
# browser reports "too many redirects"). Make it permanent once nothing needs
# reversing. NEXTAUTH_URL and SITE_URL in /opt/playerz/.env are
# https://playerz.bg; the Google OAuth client (project `playerzbg`) lists the
# playerz.bg origin and callback, and keeps the app.playerz.bg ones until the
# redirect is permanent.
#
# This header previously said "playerz.bg does not exist in DNS — no A record, no
# NS, no SOA", and explained the sslip.io name as a consequence. That was true
# when written and stopped being true the afternoon the zone was created; the
# domain was added to the site block below exactly as the old note instructed,
# and the note itself was left behind. A comment that survives the condition it
# describes is worse than no comment, because it reads as current.
#
# The sslip.io name is KEPT deliberately, not as a leftover: it resolves without
# the registrar, so it still works if the zone is mis-edited or the domain
# lapses, and it is the only way in if DNS is the thing that broke.

playerz.bg, playerz.35-187-80-26.sslip.io {
	encode gzip zstd

	# Matches agrent's. The booking API posts small JSON; the ceiling is here to
	# stop a large body reaching the app, not because anything needs it.
	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	# By container name on agrent_internal — the one network this app shares
	# with agrent's stack, because only one process can bind 80/443.
	reverse_proxy playerz-app:3000 {
		header_up Host              {host}
		header_up X-Real-IP         {remote_host}
		header_up X-Forwarded-For   {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

app.playerz.bg, www.playerz.bg {
	redir https://playerz.bg{uri} 302
}
